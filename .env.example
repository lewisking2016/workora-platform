[TEMPLATE]
# ─────────────────────────────────────────────────────────────
# Workora environment variables (copy to .env and fill in real values)
#
#   cp .env.example .env
#
# IMPORTANT: NEVER commit real credentials. docker-compose.yml currently
# has hardcoded production values that were committed by mistake — they
# must be moved into an uncommitted .env file and rotated (see SECURITY_AUDIT.md).
# ─────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Postgres connection string (Neon, Supabase, or any Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT signing secret — MUST be set in production (server refuses to start without it)
JWT_SECRET=change-me-to-a-long-random-string

# Redis for caching (optional)
REDIS_URL=redis://redis:6379

# ── Cloudflare R2 storage ────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=

# ── M-Pesa (Daraja API) ──────────────────────────────────────
# Set MPESA_ENV=production for live, sandbox for testing
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public URL where Daraja sends payment callbacks
MPESA_CALLBACK_URL=https://your-domain.com/payments/callback

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (mobile has no Origin header)
CORS_ORIGINS=http://localhost:3000,https://workora.imeantech.com

# ── Web app ──────────────────────────────────────────────────
# Public base URL used for sitemap/robots/OG tags
NEXT_PUBLIC_SITE_URL=https://workora.imeantech.com

# Backend base URL the web proxy targets ('base' = production default)
NEXT_PUBLIC_API_URL=
